// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  email      String   @unique
  password   String
  role       UserRole @default(ADMIN)
  isVerified Boolean  @default(false) @map("is_verified")
  isBlocked  Boolean  @default(false) @map("is_blocked")
  isDeleted  Boolean  @default(false) @map("is_deleted")

  // membership relation
  tenantId String? @db.Uuid

  tenant Tenant? @relation("TenantMembers", fields: [tenantId], references: [id])

  // ownership relation
  ownedTenant Tenant? @relation("TenantOwner")

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdJobs            Job[]                    @relation("JobCreatedBy")
  profileImage            String?                  @map("profile_image")
  profileImageKey         String?                  @map("profile_image_key")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  name String
  subdomain String? @unique


  ownerId String @unique @db.Uuid
  owner   User   @relation("TenantOwner", fields: [ownerId], references: [id])

  // reverse membership relation
  users User[] @relation("TenantMembers")

  isBlocked     Boolean        @default(false) @map("is_blocked")
  isDeleted     Boolean        @default(false) @map("is_deleted")
  subscriptions Subscription[]
  payments      Payment[]
  trialUsed     Boolean        @default(false)
  machines      Machine[]
  fixtures      Fixture[]
  rawMaterials  RawMaterial[]
  parts         Part[]
  jobs          Job[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("tenants")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model Plan {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  price    Decimal @db.Decimal(10, 2)
  currency String

  isBlocked Boolean @default(false) @map("is_blocked")
  isDeleted Boolean @default(false) @map("is_deleted")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  durationDays Int?
  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  razorpaySubscriptionId String?
  payments               Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  subscriptionId    String?         @db.Uuid
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
  planId            String?         @db.Uuid
  plan              Plan?           @relation(fields: [planId], references: [id])
  amount            Decimal         @db.Decimal(10, 2)
  currency          String
  provider          PaymentProvider
  providerPaymentId String?
  providerOrderId   String?
  status            PaymentStatus
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MACHINIST
  MAINTENANCE
}

model Machine {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  name           String
  brand          String
  maxRpm         Int           @map("max_rpm")
  axis           Int
  type           MachineType
  maxTravelSpeed Int           @map("max_travel_speed")
  holdingSize    Int           @map("holding_size")
  toolCount      Int           @map("tool_count")
  status         MachineStatus
  isBlocked      Boolean       @default(false) @map("is_blocked")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  parts          Part[]

  @@map("machines")
}

enum MachineType {
  MILL
  LATHE
}

enum MachineStatus {
  IDLE
  RUNNING
  MAINTENANCE
}

model Fixture {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  name       String
  dimensions Json
  type       FixtureType
  isBlocked  Boolean     @default(false) @map("is_blocked")
  isDeleted  Boolean     @default(false) @map("is_deleted")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  parts      Part[]

  @@map("fixtures")
}

enum FixtureType {
  MILL
  LATHE
}

model RawMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  dimensions Json
  material   String
  minQty     Int      @map("min_qty")
  currentQty Int      @default(0) @map("current_qty")
  isBlocked  Boolean  @default(false) @map("is_blocked")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  parts      Part[]

  @@map("raw_materials")
}

model Part {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  name               String
  partNumber         String   @map("part_number")
  description        String?
  material           String?
  operationType      OperationType? @map("operation_type")
  
  // nc_program is future plan
  // ncProgramId String? @map("nc_program_id") @db.Uuid

  machineId          String?  @map("machine_id") @db.Uuid
  machine            Machine? @relation(fields: [machineId], references: [id])

  fixtureId          String?  @map("fixture_id") @db.Uuid
  fixture            Fixture? @relation(fields: [fixtureId], references: [id])

  rawMaterialId      String?  @map("raw_material_id") @db.Uuid
  rawMaterial        RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  dimensions         Json?    @map("dimensions")
  cycleTime          String?  @map("cycle_time")
  setupTime          String?  @map("setup_time")

  setupSheet         String?  @map("setup_sheet")
  setupSheetKey      String?  @map("setup_sheet_key")
  engineeringDrawing String?  @map("engineering_drawing")
  engineeringDrawingKey String? @map("engineering_drawing_key")

  priority           PartPriority @default(MEDIUM)
  isBlocked          Boolean  @default(false) @map("is_blocked")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  jobs               Job[]
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, partNumber])
  @@map("parts")
}

enum OperationType {
  MILL
  LATHE
}

enum PartPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}


model Job {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  partId     String      @map("part_id") @db.Uuid
  part       Part        @relation(fields: [partId], references: [id])
  quantity   Int
  priority   JobPriority
  repeat     Boolean     @default(false)
  status     JobStatus   @default(PENDING)
  isDeleted  Boolean     @default(false) @map("is_deleted")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  createdByUserId String @map("created_by") @db.Uuid
  creator         User   @relation("JobCreatedBy", fields: [createdByUserId], references: [id])

  @@map("jobs")
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// lookup table
model Lookup {
  id          String   @id @default(uuid()) @db.Uuid
  category    String
  code        String
  label       String
  description String?
  value       String?
  sortOrder   Int      @default(0) @map("sort_order")
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")
  tenantId    String?  @db.Uuid @map("tenant_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([category, code, tenantId])
  @@map("lookups")
}
