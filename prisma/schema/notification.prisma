enum NotificationType {
  MACHINE_CREATED
  INFO
  ALERT
  RAW_MATERIAL_LOW_STOCK
  SHIFT_CREATED
  SHIFT_EDITED
  SHIFT_DELETED
  MAINTENANCE_TICKET_CREATED
  MAINTENANCE_TICKET_UPDATED
  MAINTENANCE_TICKET_DELETED
  MAINTENANCE_TICKET_CLOSED
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String?          @db.Uuid @map("tenant_id")
  userId    String?          @db.Uuid @map("user_id")
  role      String?          @map("role")
  type      NotificationType @map("type")
  title     String           @map("title")
  message   String           @map("message")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User?            @relation("UserNotifications", fields: [userId], references: [id])
  tenant    Tenant?          @relation("TenantNotifications", fields: [tenantId], references: [id])

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}
